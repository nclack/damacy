{
  "version": 1,
  "id": "microscopy-cold-reader-v1",
  "label": "Cold NVMe microscopy reads: chunks, blocks, and codecs",
  "corpus_version": 3,
  "cache_policy": "cold",
  "inputs": [
    "opencell-dna", "opencell-protein", "bbbc010-brightfield",
    "jump-scope-fluorescence", "dynacell-a549-phase", "cosem-cos7-em", "bbbc022-mito"
  ],
  "pilot_inputs": ["bbbc010-brightfield", "dynacell-a549-phase", "cosem-cos7-em"],
  "backends": ["cpu", "cuda"],
  "chunk_bytes": [16384, 65536, 262144, 1048576],
  "shard_shape": [1, 1024, 1024],
  "codecs": ["none", "zstd", "blosc-zstd"],
  "level": 3,
  "blosc_block_bytes": [16384, "chunk"],
  "patterns": [
    {"id": "random-256", "pattern": "random", "sample_shape": [1, 256, 256], "samples_per_batch": 128},
    {"id": "whole-planes", "pattern": "planes", "samples_per_batch": 8}
  ],
  "profile": {
    "repeats": 3,
    "bytes_per_pass": 1073741824,
    "warmup_batches": 16,
    "min_seconds": 2,
    "reference_seconds": 4,
    "timeout_seconds": 120
  },
  "pilot_profile": {
    "repeats": 2,
    "bytes_per_pass": 134217728,
    "warmup_batches": 4,
    "min_seconds": 0.5,
    "reference_seconds": 3,
    "timeout_seconds": 90
  },
  "pilot_settings": [
    {"codec": "none", "chunk_bytes": 262144, "block_bytes": null},
    {"codec": "zstd", "chunk_bytes": 16384, "block_bytes": null},
    {"codec": "blosc-zstd", "chunk_bytes": 262144, "block_bytes": 16384},
    {"codec": "blosc-zstd", "chunk_bytes": 262144, "block_bytes": 262144}
  ],
  "reference_setting": {"codec": "none", "chunk_bytes": 262144, "block_bytes": null},
  "query_seed": 1234,
  "order_seed": 20261104,
  "pipeline": {
    "dtype": "f32",
    "lookahead_samples": 512,
    "n_io_threads": 8,
    "metadata_io_concurrency": 32,
    "decode_workers": 8,
    "chunks_per_input_buffer": 128,
    "max_cpu_memory_mb": 4096,
    "max_gpu_memory_mb": 6144,
    "max_chunk_uncompressed_mb": 1,
    "max_substreams_per_chunk": 64,
    "max_read_op_kb": 2048,
    "n_array_meta_cache": 1024,
    "n_shard_index_cache": 16384,
    "n_chunk_layout_cache": 1024,
    "max_shards_per_sample": 16
  }
}
